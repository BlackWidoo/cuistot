# Copie ce fichier en .env pour le développement local (le .env réel ne doit jamais être commité).
# En production (Render), ces variables se configurent dans l'onglet "Environment" du service,
# pas dans un fichier — voir render.yaml pour celles générées automatiquement.

# --- Cœur de l'app ---
NODE_ENV=development
PORT=3000

# Secret de signature des JWT de session. OBLIGATOIRE en production (le serveur refuse de
# démarrer sans elle) — génère une longue valeur aléatoire, ex: `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-secret

# --- Base de données ---
# DATABASE_URL : à utiliser en production dès le Lot 1 (PostgreSQL). Non consommée pour
# l'instant par le code (toujours SQLite) — réservée pour la migration à venir.
DATABASE_URL=
# DB_PATH : chemin du fichier SQLite, utilisé en local et dans les tests (DB_PATH=":memory:"
# dans les tests). Reste utilisable après la migration Postgres pour le dev rapide.
DB_PATH=./cuistot.db

# URL publique de l'app, utilisée pour construire des liens fiables (ex: lien de reset de mot
# de passe) — ne jamais reconstruire une URL à partir des headers de la requête.
APP_URL=http://localhost:3000

# --- Email transactionnel (Lot 3 — reset de mot de passe) ---
# Tant que ces variables ne sont pas renseignées, le lien de reset est journalisé côté
# serveur (console.log) au lieu d'être envoyé par email — pratique en dev, insuffisant en prod.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Cuistot <noreply@example.com>

# --- Stockage médias (Lot 2 — upload de photos) ---
# Tant que ces variables ne sont pas renseignées, les photos restent stockées en base64
# directement en base (comportement actuel, à migrer).
MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Observabilité (Lot 5) ---
SENTRY_DSN=

# --- Anti-abus à l'échelle (Lot 4) ---
# Tant que vide, le rate limiting reste en mémoire process (suffisant pour une seule
# instance, mais ne tient pas la route avec plusieurs instances derrière un load balancer).
REDIS_URL=

# --- Infra interne ---
# Protège /health/ready (détails de connectivité DB/médias) pour qu'il ne soit pas public.
# Générée automatiquement sur Render (voir render.yaml) ; à définir toi-même en local si tu
# veux tester cette route hors production.
HEALTH_CHECK_KEY=

# --- Modération ---
# Email du compte qui doit devenir administrateur (accès au panel de modération). Au
# démarrage, si ce compte existe déjà, il est promu automatiquement. Aucun compte externe
# requis — c'est juste ton propre email de compte Cuistot.
ADMIN_EMAIL=
